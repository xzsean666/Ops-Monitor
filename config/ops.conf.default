# ==============================================================================
# Ops-Monitor 默认出厂配置文件
# 权限必须保持为 0600 (仅所有者可读写)
# ==============================================================================

# --- 采集与保留策略 ---
COLLECT_INTERVAL=60                     # 采样周期 (秒)
RETENTION_DAYS=1                        # 本地分钟级指标保留天数
# ARCHIVE_DIR="/var/log/ops_archive"      # 归档目录 (为空则不归档直接删除)

# --- 告警阈值与防抖 ---
ALERT_CPU_THRESHOLD=85                  # CPU 告警阈值 (%)
ALERT_CPU_CONSECUTIVE=3                 # CPU 连续超限触发次数 (防抖)
ALERT_MEM_THRESHOLD=90                  # 内存告警阈值 (%)
ALERT_DISK_THRESHOLD=85                 # 磁盘主分区告警阈值 (%)
ALERT_NET_RX_THRESHOLD_MB=50            # 网络入站/下载告警阈值 (MB/s, 0 为关闭)
ALERT_NET_TX_THRESHOLD_MB=50            # 网络出站/上传告警阈值 (MB/s, 0 为关闭)
ALERT_NET_CONSECUTIVE=3                 # 网络流量连续超限触发次数 (防抖)
ALERT_COOLDOWN_MINUTES=30               # 告警抑制冷却周期 (分钟)

# --- Webhook 通信渠道 ---
WEBHOOK_SLACK_URL=""
WEBHOOK_DINGTALK_URL=""
WEBHOOK_DINGTALK_SECRET=""
WEBHOOK_FEISHU_URL=""
WEBHOOK_WECOM_URL=""

# --- 业务服务健康探测与自愈 (Service Health & Self-Healing) ---
# 格式: 服务名|探活URL|重启自愈命令(可选)|连续失败次数(可选)|冷却分钟(可选)|超时秒(可选)
# 多个服务使用分号 ; 或换行分隔
# 示例: SERVICE_HEALTH_CHECKS="AstarFi-Backend|http://127.0.0.1:10101/health|docker restart astar-fi-backend-v2-stag"
SERVICE_HEALTH_CHECKS=""
SERVICE_HEALTH_CONSECUTIVE=2             # 默认连续探测失败触发次数 (防抖)
SERVICE_HEALTH_COOLDOWN_MINUTES=10       # 默认自愈与告警抑制冷却时长 (分钟)
SERVICE_HEALTH_TIMEOUT_SECONDS=5         # 默认 HTTP 探活请求超时 (秒)

# --- 容器资源与内存告警 (防 V8 堆内存 OOM 盲区) ---
ALERT_CONTAINER_MEM_THRESHOLD=80          # 容器内存使用率告警阈值 (%)

